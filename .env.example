# Copy to .env and adjust. .env is gitignored; this file is not.

# ── Database ────────────────────────────────────────────────────────
OPTIEDT_DATABASE_URL=postgresql+psycopg://optiedt:optiedt@localhost:5432/optiedt

# ── Security ────────────────────────────────────────────────────────
OPTIEDT_SECRET_KEY=change-me
OPTIEDT_ACCESS_TOKEN_EXPIRE_MINUTES=480

# ── Solver ──────────────────────────────────────────────────────────
# Deterministic time per weight profile — NOT wall-clock seconds.
# Wall-clock bounds with parallel workers are not reproducible; a fixed seed
# does not fix it. See ADR-011.
#
# The deterministic-to-wall-clock ratio is machine-dependent and has NOT been
# calibrated yet. Until it is, any wall-clock expectation from this number is a
# guess. See docs/status.md, "Measurements".
OPTIEDT_SOLVER_DETERMINISTIC_BUDGET=120.0

# Hang backstop only, never the primary bound.
OPTIEDT_SOLVER_WALL_CLOCK_CEILING_SECONDS=900.0

# 0 = all available. The diagnosis run overrides this to 1 — CP-SAT imposes it.
OPTIEDT_SOLVER_WORKERS=0

# Recorded with every run. Reproducibility is an acceptance criterion.
OPTIEDT_SOLVER_SEED=42

# ── Assistant ───────────────────────────────────────────────────────
# Off by default. Everything must work with it off: generation, scoring,
# ranking, comparison, regeneration and publication all remain available and
# only text disappears. Setting this to false is how degraded mode is tested.
OPTIEDT_ASSISTANT_ENABLED=false
OPTIEDT_ASSISTANT_BASE_URL=
OPTIEDT_ASSISTANT_API_KEY=
OPTIEDT_ASSISTANT_MODEL=
OPTIEDT_ASSISTANT_TIMEOUT_SECONDS=10.0

# ── Instance ────────────────────────────────────────────────────────
OPTIEDT_INSTANCE_PATH=../data/instance
OPTIEDT_CONSTRAINT_CATALOGUE_PATH=../data/instance/constraint_catalogue.csv
